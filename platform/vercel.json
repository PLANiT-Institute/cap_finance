{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {"api/simulate.py": {"runtime": "@vercel/python@4.3.0", "maxDuration": 60, "includeFiles": "engine/**"}},
  "headers": [{"source":"/(.*)","headers":[{"key":"X-Robots-Tag","value":"noindex"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Content-Type-Options","value":"nosniff"}]}]
}
